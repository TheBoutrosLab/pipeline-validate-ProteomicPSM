includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))
def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')

params {
    input_csv = "${projectDir}/test/test_integration_epifany/input.csv"
    input_mzml_csv = "${projectDir}/test/test_integration_epifany/mzml.csv"
    output_dir = System.getenv('NFT_OUTPUT') ?: "${projectDir}/test/output/test_integration_epifany"
    decoy_database = "${TEST_DATA_DIR}/database/2026-01-12-decoys-Escherichia_coli_str_k_12_substr_mg1655_gca_000005845.ASM584v2.pep.all_contam.fa.fas"
    decoy_string = 'rev_'
    enzyme = 'Trypsin/P'
    index_peptides_unmatched_action = 'remove'
    save_intermediate_files = true
    merge_consensus = false
    fractionated = false
    skip_peptide_indexing = false
    run_percolator = true
    percolator_workflow = 'msbooster'
    run_protloom = false
    export_easypqp_reports = true
    easypqp_psm_qvalue = 0.01
    protein_inference_algorithm = 'Epifany'
    epifany_greedy_group_resolution = 'remove_associations_only'
    dataset_id = 'ECOLI_DIA'
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(params.input_csv, 'test_integration_epifany', launchDir)
params.input_mzml_csv = csvEnvironmentExpander.prepareInputCsv(params.input_mzml_csv, 'test_integration_epifany_mzml', launchDir)
methods.setup()

process {
    echo = false
}
