includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))
def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')

params {
    input_csv = "${projectDir}/test/test_integration_msbooster/input.csv"
    input_mzml_csv = "${projectDir}/test/test_integration_msbooster/mzml.csv"
    output_dir = System.getenv('NFT_OUTPUT') ?: "${projectDir}/test/output/test_integration_msbooster"
    decoy_database = "${TEST_DATA_DIR}/database/2026-01-12-decoys-Escherichia_coli_str_k_12_substr_mg1655_gca_000005845.ASM584v2.pep.all_contam.fa.fas"
    decoy_string = 'rev_'
    save_intermediate_files = true
    merge_consensus = true
    fractionated = true
    skip_peptide_indexing = false
    run_percolator = true
    percolator_workflow = 'msbooster'
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(params.input_csv, 'test_integration_msbooster', launchDir)
params.input_mzml_csv = csvEnvironmentExpander.prepareInputCsv(params.input_mzml_csv, 'test_integration_msbooster_mzml', launchDir)
methods.setup()

process {
    echo = false
}