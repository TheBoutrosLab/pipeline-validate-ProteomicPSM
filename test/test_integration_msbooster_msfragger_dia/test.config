includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))
def TEST_DATA_DIR = System.getenv('TEST_DATA_DIR')

params {
    dataset_id = 'ECOLI-DIA'
    input_csv = "${projectDir}/test/test_integration_msbooster_msfragger_dia/input.csv"
    input_mzml_csv = "${projectDir}/test/test_integration_msbooster_msfragger_dia/mzml.csv"
    output_dir = System.getenv('NFT_OUTPUT') ?: "${projectDir}/test/output/test_integration_msbooster_msfragger_dia"
    decoy_database = "${TEST_DATA_DIR}/database/Ecoli_k_12-UniProt.fasta"
    decoy_string = 'DECOY_'
    enzyme = 'Trypsin/P'
    index_peptides_unmatched_action = 'remove'
    index_peptides_aaa_max = 0
    save_intermediate_files = true
    merge_consensus = false
    fractionated = false
    skip_peptide_indexing = false
    run_percolator = true
    percolator_workflow = 'msbooster'
    run_protloom = true
    protloom_project_yaml = "${TEST_DATA_DIR}/ecoli_dia/protloom_project.yaml"
    protloom_pc_order = 'proteotypic'
    protloom_pt_order = 'canonical'
    export_easypqp_reports = true
    protloom_idxml_primary_score = 'pep'
}

params.input_csv = csvEnvironmentExpander.prepareInputCsv(params.input_csv, 'test_integration_msbooster_msfragger_dia', launchDir)
params.input_mzml_csv = csvEnvironmentExpander.prepareInputCsv(params.input_mzml_csv, 'test_integration_msbooster_msfragger_dia_mzml', launchDir)
methods.setup()

process {
    echo = false
}
