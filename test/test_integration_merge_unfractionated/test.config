includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"


def csvEnvironmentExpander = evaluate(new File("${projectDir}/test/csv_environment_expander.groovy"))

params {
    input_csv = "${projectDir}/test/test_integration_merge_unfractionated/input.csv"
    output_dir = System.getenv('NFT_OUTPUT') ?: "${projectDir}/test/output/test_integration_merge_unfractionated"
    decoy_database = "${System.getenv('TEST_DATA_DIR')}/2026-01-12-decoys-Escherichia_coli_str_k_12_substr_mg1655_gca_000005845.ASM584v2.pep.all_contam.fa.fas"
    decoy_string = 'rev_'
    sample_name = 'SBP0001'
    save_intermediate_files = true
    merge_consensus = true
    fractionated = false
    skip_peptide_indexing = false
    run_percolator = true
}


params.input_csv = csvEnvironmentExpander.prepareInputCsv(params.input_csv, 'test_integration_merge_unfractionated', launchDir)
methods.setup()
