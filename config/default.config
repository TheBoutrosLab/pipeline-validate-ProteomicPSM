import nextflow.util.SysHelper

params {
    max_cpus = SysHelper.getAvailCpus()
    max_memory = SysHelper.getAvailMemory()
    min_cpus = 1
    min_memory = 1.MB
    resource_allocation_profile_tag = 'default'
    ucla_cds = false

    openms_version = '3.5.0'
    docker_image_openms = "ghcr.io/theboutroslab/openms-thirdparty:${params.openms_version}"
    pyopenms_version = '3.5.0'
    docker_image_pyopenms = "ghcr.io/theboutroslab/pyopenms:${params.pyopenms_version}"
    fragpipe_version = '24.0'
    docker_image_fragpipe = "fcyucn/fragpipe:${params.fragpipe_version}"
    msbooster_params = "${projectDir}/input/msbooster.params"
    protloom_version = '0.2.3'
    docker_image_protloom = "ghcr.io/theboutroslab/protloom:${params.protloom_version}"
    run_protloom = false
    dataset_id = 'cohort'
    export_easypqp_reports = false
    proteinprophet_min_probability = 0.0
    proteinprophet_easypqp_psm_qvalue = 0.01
    protloom_project_yaml = ''
    protloom_project = null
    protloom_pt_order = ''
    protloom_pc_order = ''
    protloom_enzyme = 'trypsin'
    protloom_easypqp_fdr = 0.01
    protloom_idxml_primary_score = 'original'
    protloom_idxml_unmatched_psms = 'remove'

    decoy_string = 'DECOY_'
    enzyme = 'Trypsin'
    merge_consensus = true
    consensusid_algorithm = null
    fractionated = false
    skip_peptide_indexing = false
    run_percolator = true
    percolator_workflow = 'openms'
    percolator_post_processing_tdc = true
    fdr_algorithm_no_qvalues = false
    filter_psm_score_peptide = 0.01
    filter_psm_remove_decoys = true
    filter_psm_keep_unreferenced_protein_hits = false
    filter_psm_delete_unreferenced_peptide_hits = true
    filter_psm_whitelist_proteins = "${projectDir}/input/NO_FILE"
    filter_psm_whitelist_peptides = "${projectDir}/input/NO_FILE"
    filter_psm_blacklist_proteins = "${projectDir}/input/NO_FILE"
    filter_psm_blacklist_peptides = "${projectDir}/input/NO_FILE"
    filter_psm_in_silico_digestion = "${projectDir}/input/NO_FILE"
    save_intermediate_files = false
    project_script_mount_options = "-v ${projectDir}/src:${projectDir}/src:ro"

}

profiles {
    standard {
        docker.enabled = true
        apptainer.enabled = false
        singularity.enabled = false
        docker.runOptions = "-u \$(id -u):\$(id -g) \$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
    }
    docker {
        docker.enabled = true
        apptainer.enabled = false
        singularity.enabled = false
        docker.runOptions = "-u \$(id -u):\$(id -g) \$(for i in `id --real --groups`; do echo -n \"--group-add=\$i \"; done)"
    }
    apptainer {
        docker.enabled = false
        apptainer.enabled = true
        singularity.enabled = false
        apptainer.autoMounts = true
        apptainer.ociAutoPull = true
        params.project_script_mount_options = "--bind ${projectDir}/src:${projectDir}/src:ro"
    }
    singularity {
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.ociAutoPull = true
        params.project_script_mount_options = "--bind ${projectDir}/src:${projectDir}/src:ro"
    }
    local {
        docker.enabled = false
        apptainer.enabled = false
        singularity.enabled = false
        params.project_script_mount_options = ""
    }
}

process {
    executor = 'local'
    debug = false
    cache = true
}
