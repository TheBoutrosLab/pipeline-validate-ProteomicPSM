includeConfig "../external/pipeline-Nextflow-config/config/schema/schema.config"
includeConfig "../external/pipeline-Nextflow-config/config/methods/common_methods.config"
includeConfig "../external/pipeline-Nextflow-config/config/resource_handler/resource_handler.config"
includeConfig "../external/pipeline-Nextflow-config/config/store_object_as_json/store_object_as_json.config"

methods {
    set_output_dir = {
        def tz = TimeZone.getTimeZone('UTC')
        def timestamp = new Date().format("yyyyMMdd'T'HHmmss'Z'", tz)
        def software = "OpenMS-${params.openms_version}"
        def root = "${params.output_dir}/${manifest.name}-${manifest.version}"
        params.final_output_dir = "${root}"
        params.intermediate_file_dir = "${root}"
        params.log_output_dir = "${root}/log-${manifest.name}-${manifest.version}-${timestamp}/${software}"
        params.pipeline_log_dir = "${params.log_output_dir}/nextflow-log"
        params.process_log_dir = "${params.log_output_dir}/process-log"
    }

    set_pipeline_log = {
        trace.enabled = true
        trace.file = "${params.pipeline_log_dir}/trace.txt"
        timeline.enabled = true
        timeline.file = "${params.pipeline_log_dir}/timeline.html"
        report.enabled = true
        report.file = "${params.pipeline_log_dir}/report.html"
    }

    validate_psm = {
        def enzymes = ['Trypsin':'trypsin', 'Arg-C':'arg-c', 'Asp-N':'asp-n',
            'Chymotrypsin':'chymotrypsin', 'Lys-C':'lys-c', 'Lys-N':'lys-n',
            'PepsinA':'pepsin', 'Trypsin/P':'trypsinp',
            'leukocyte elastase':'elastase', 'glutamyl endopeptidase':'glu-c',
            'no cleavage':'no_enzyme']
        def enzyme = (params.enzyme as String).replaceAll(/^[\'"]|[\'"]$/, '')
        if (params.run_percolator && !enzymes.containsKey(enzyme)) {
            throw new IllegalArgumentException("Enzyme ${enzyme} not supported for Percolator")
        }
        params.enzyme_percolator = enzymes[enzyme]
    }

    load_protloom_project = {
        if (params.export_easypqp_reports && !params.run_percolator) {
            throw new IllegalArgumentException('EasyPQP export requires Percolator results.')
        }
        if (params.export_easypqp_reports && !params.input_mzml_csv) {
            throw new IllegalArgumentException('input_mzml_csv is required for EasyPQP export.')
        }
        if ((params.run_protloom || params.export_easypqp_reports) &&
            !(params.dataset_id?.toString() ==~ /[A-Za-z0-9][A-Za-z0-9._-]*/)) {
            throw new IllegalArgumentException('dataset_id must be a single directory name containing letters, digits, dots, underscores, or hyphens.')
        }
        if (params.export_easypqp_reports && !params.run_protloom) {
            if (params.fdr_algorithm_no_qvalues) {
                throw new IllegalArgumentException('ProteinProphet EasyPQP export requires OpenMS q-values.')
            }
            if (!(params.proteinprophet_min_probability instanceof Number) ||
                params.proteinprophet_min_probability < 0 ||
                params.proteinprophet_min_probability >= 1) {
                throw new IllegalArgumentException('proteinprophet_min_probability must be in [0, 1).')
            }
            if (!(params.proteinprophet_easypqp_psm_qvalue instanceof Number) ||
                params.proteinprophet_easypqp_psm_qvalue < 0 ||
                params.proteinprophet_easypqp_psm_qvalue > 1) {
                throw new IllegalArgumentException('proteinprophet_easypqp_psm_qvalue must be in [0, 1].')
            }
        }
        if (!params.run_protloom) {
            return
        }
        if (!params.run_percolator || params.percolator_workflow != 'msbooster') {
            throw new IllegalArgumentException('ProtLoom currently requires the MSBooster and Percolator workflow.')
        }
        if (!(params.protloom_idxml_primary_score in ['original', 'pep', 'q_value', 'q-value'])) {
            throw new IllegalArgumentException('protloom_idxml_primary_score must be original, pep, q_value, or q-value.')
        }
        if (!(params.protloom_idxml_unmatched_psms in ['remove', 'keep'])) {
            throw new IllegalArgumentException('protloom_idxml_unmatched_psms must be remove or keep.')
        }
        ['protloom_project_yaml', 'protloom_pt_order', 'protloom_pc_order'].each { name ->
            if (!params[name]?.toString()?.trim()) {
                throw new IllegalArgumentException("${name} is required when run_protloom = true.")
            }
        }

        def project_file = new File(params.protloom_project_yaml.toString()).canonicalFile
        if (!project_file.isFile()) {
            throw new IllegalArgumentException("ProtLoom project YAML does not exist: ${project_file}")
        }
        def document = new org.yaml.snakeyaml.Yaml().load(project_file.text)
        if (!(document instanceof Map) || document.schema_version != 1) {
            throw new IllegalArgumentException('ProtLoom project YAML requires schema_version: 1.')
        }
        def resolve_input = { value, label ->
            if (!value?.toString()?.trim()) {
                throw new IllegalArgumentException("ProtLoom project YAML is missing ${label}.")
            }
            def candidate = new File(value.toString())
            def resolved = (candidate.isAbsolute() ? candidate :
                new File(project_file.parentFile, value.toString())).canonicalFile
            if (!resolved.isFile()) {
                throw new IllegalArgumentException("ProtLoom ${label} does not exist: ${resolved}")
            }
            resolved.toString()
        }
        def database = document.database
        if (!(database instanceof Map)) {
            throw new IllegalArgumentException('ProtLoom project YAML requires a database section.')
        }
        def fasta = resolve_input(database.output_fasta, 'database.output_fasta')
        def entries = resolve_input(database.output_entries_tsv, 'database.output_entries_tsv')
        def annotation_rows = document.annotations
        if (!(annotation_rows instanceof List) || !annotation_rows) {
            throw new IllegalArgumentException('ProtLoom project YAML requires annotations with GTF paths.')
        }
        def annotations = (0..<annotation_rows.size()).collect { index ->
            def row = annotation_rows[index]
            def annotation_id = row?.annotation_id?.toString()?.trim()
            if (!annotation_id) {
                throw new IllegalArgumentException("ProtLoom annotations[${index}] is missing annotation_id.")
            }
            [annotation_id: annotation_id,
             gtf_path: resolve_input(row.gtf_path, "annotations[${index}].gtf_path")]
        }
        def filenames = annotations.collect { new File(it.gtf_path).name }
        if (filenames.size() != filenames.toSet().size()) {
            throw new IllegalArgumentException('ProtLoom annotation GTF basenames must be unique for Nextflow staging.')
        }
        def annotation_ids = annotations.collect { it.annotation_id }.toSet()
        def sample_rows = document.samples
        if (!(sample_rows instanceof List) || !sample_rows) {
            throw new IllegalArgumentException('ProtLoom project YAML requires samples with sample_id and annotation_id.')
        }
        def sample_annotations = [:]
        sample_rows.each { row ->
            def sample_id = row?.sample_id?.toString()?.trim()
            def annotation_id = row?.annotation_id?.toString()?.trim()
            if (!sample_id || !annotation_ids.contains(annotation_id)) {
                throw new IllegalArgumentException("ProtLoom sample '${sample_id}' needs an annotation_id listed in annotations.")
            }
            if (sample_annotations.containsKey(sample_id)) {
                throw new IllegalArgumentException("Duplicate ProtLoom sample_id: ${sample_id}")
            }
            sample_annotations[sample_id] = annotation_id
        }
        def markers = [
            decoy_string: database.decoy_string ?: 'DECOY_',
            decoy_position: database.decoy_position ?: 'prefix',
            contam_string: database.contam_string ?: 'CONTAMINANT_',
            contam_position: database.contam_position ?: 'prefix'
        ]
        if (!(markers.decoy_position in ['prefix', 'suffix']) ||
            !(markers.contam_position in ['prefix', 'suffix'])) {
            throw new IllegalArgumentException('ProtLoom marker positions must be prefix or suffix.')
        }
        if (params.decoy_string != markers.decoy_string) {
            throw new IllegalArgumentException('decoy_string must match database.decoy_string in the ProtLoom project YAML.')
        }
        params.protloom_project = [fasta: fasta, entries: entries,
            annotations: annotations, markers: markers,
            sample_annotations: sample_annotations]
    }

    setup = {
        schema.load_custom_types("${projectDir}/config/custom_schema_types.config")
        schema.validate()
        methods.validate_psm()
        methods.load_protloom_project()
        methods.set_output_dir()
        methods.set_pipeline_log()
        resource_handler.handle_resources("${projectDir}/config/resources.json")
        methods.set_env()
        methods.configure_containerization()
        methods.setup_process_afterscript()
        json_extractor.store_object_as_json(params, new File("${params.pipeline_log_dir}/params.json"))
    }
}
