includeConfig "../external/pipeline-Nextflow-config/config/schema/schema.config"
includeConfig "../external/pipeline-Nextflow-config/config/methods/common_methods.config"
includeConfig "../external/pipeline-Nextflow-config/config/resource_handler/resource_handler.config"
includeConfig "../external/pipeline-Nextflow-config/config/store_object_as_json/store_object_as_json.config"

methods {
    set_output_dir = {
        def tz = TimeZone.getTimeZone('UTC')
        def timestamp = new Date().format("yyyyMMdd'T'HHmmss'Z'", tz)
        def software = "OpenMS-${params.openms_version}"
        def root = "${params.output_dir}/${manifest.name}-${manifest.version}"
        params.final_output_dir = "${root}"
        params.intermediate_file_dir = "${root}"
        params.log_output_dir = "${root}/log-${manifest.name}-${manifest.version}-${timestamp}/${software}"
        params.pipeline_log_dir = "${params.log_output_dir}/nextflow-log"
        params.process_log_dir = "${params.log_output_dir}/process-log"
    }

    set_pipeline_log = {
        trace.enabled = true
        trace.file = "${params.pipeline_log_dir}/trace.txt"
        timeline.enabled = true
        timeline.file = "${params.pipeline_log_dir}/timeline.html"
        report.enabled = true
        report.file = "${params.pipeline_log_dir}/report.html"
    }

    validate_psm = {
        def enzymes = ['Trypsin':'trypsin', 'Arg-C':'arg-c', 'Asp-N':'asp-n',
            'Chymotrypsin':'chymotrypsin', 'Lys-C':'lys-c', 'Lys-N':'lys-n',
            'PepsinA':'pepsin', 'Trypsin/P':'trypsinp',
            'leukocyte elastase':'elastase', 'glutamyl endopeptidase':'glu-c',
            'no cleavage':'no_enzyme']
        def enzyme = (params.enzyme as String).replaceAll(/^[\'"]|[\'"]$/, '')
        if (params.run_percolator && !enzymes.containsKey(enzyme)) {
            throw new IllegalArgumentException("Enzyme ${enzyme} not supported for Percolator")
        }
        params.enzyme_percolator = enzymes[enzyme]
    }

    setup = {
        schema.load_custom_types("${projectDir}/config/custom_schema_types.config")
        schema.validate()
        methods.validate_psm()
        methods.set_output_dir()
        methods.set_pipeline_log()
        resource_handler.handle_resources("${projectDir}/config/resources.json")
        methods.set_env()
        methods.configure_containerization()
        methods.setup_process_afterscript()
        json_extractor.store_object_as_json(params, new File("${params.pipeline_log_dir}/params.json"))
    }
}
