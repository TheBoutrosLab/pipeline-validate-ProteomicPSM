includeConfig "${projectDir}/config/default.config"
includeConfig "${projectDir}/config/methods.config"
includeConfig "${projectDir}/nextflow.config"

params {
    input_csv = '/path/to/input.csv'
    // Required when percolator_workflow = 'msbooster'.
    // input_mzml_csv = '/path/to/mzml.csv'
    output_dir = '/path/to/output'
    decoy_database = '/path/to/target-decoy.fasta'
    decoy_string = 'DECOY_'
    merge_consensus = true
    fractionated = false
    run_percolator = true
    percolator_workflow = 'openms'
    // Optional ProtLoom inference (requires MSBooster and Percolator).
    run_protloom = false
    dataset_id = 'cohort'
    export_easypqp_reports = false
    protloom_project_yaml = '/path/to/protloom-project.yaml'
    protloom_pt_order = ''
    protloom_pc_order = ''
    protloom_easypqp_fdr = 0.01
    protloom_idxml_primary_score = 'original'
    protloom_idxml_unmatched_psms = 'remove'
    // Optional: override the bundled DIA-NN prediction settings.
    // msbooster_params = '/path/to/msbooster.params'
    skip_peptide_indexing = false
}

methods.setup()
